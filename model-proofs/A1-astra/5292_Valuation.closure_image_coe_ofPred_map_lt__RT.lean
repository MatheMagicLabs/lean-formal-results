theorem closure_image_coe_ofPred_map_lt {r : Γ₀} (hr : r ≠ 0) :
    closure ((↑) '' {x : K | v x < r}) = {x : Completion K | v.extension x < r} := by
  apply subset_antisymm
  · intro x hx
    change v.extension x < r
    rcases eq_or_ne x 0 with rfl | hne
    · simpa using (pos_iff_ne_zero.mpr hr)
    · obtain ⟨y, hy, a, ha, rfl⟩ :=
        mem_closure_iff_nhds.1 hx _ (v.extension_locally_const hne)
      calc
        v.extension x = v a := by simpa using hy.symm
        _ < r := ha
  · intro x hx
    rw [mem_closure_iff_nhds]
    intro U hU
    obtain ⟨a, ha, hval⟩ := v.exists_coe_mem_extension_eq hU
    refine ⟨(a : Completion K), ha, a, ?_, rfl⟩
    change v a < r
    rw [← hval]
    exact hx
