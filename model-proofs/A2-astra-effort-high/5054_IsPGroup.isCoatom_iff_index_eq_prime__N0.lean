variable {p : ℕ} [hp : Fact p.Prime]

theorem isCoatom_iff_index_eq_prime [Group.IsNilpotent G] (hG : IsPGroup p G) {H : Subgroup G} :
    IsCoatom H ↔ H.index = p := by
  rw [Subgroup.isCoatom_iff_index_prime]
  constructor
  · intro hH
    haveI : H.FiniteIndex := ⟨hH.ne_zero⟩
    obtain ⟨n, hn⟩ := hG.index H
    cases n with
    | zero =>
        simp only [pow_zero] at hn
        exact (hH.ne_one hn).elim
    | succ n =>
        have hd : p ∣ H.index := by
          rw [hn, pow_succ]
          exact dvd_mul_left _ _
        rcases (Nat.dvd_prime hH).mp hd with h | h
        · exact (hp.out.ne_one h).elim
        · exact h.symm
  · intro h
    simpa only [h] using hp.out
